# =========================================================
# CISO ASSISTANT — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIG
# =========================================================
# Copy this file to .env before starting the stack:
# cp .env.example .env

# =========================================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# =========================================================
# Base URL of the deployed application (used for link generation and CORS)
CISO_ASSISTANT_URL=https://<YOUR_DOMAIN>
ALLOWED_HOSTS=<YOUR_DOMAIN>,localhost,backend

# =========================================================
# 2. DJANGO BACKEND CONFIGURATION
# =========================================================
# Secret key for cryptographic signing. Generate a strong random key in production!
SECRET_KEY=<GENERATE_STRONG_RANDOM_SECRET_KEY>
DJANGO_DEBUG=False

# Comma-separated trusted origins for CSRF validation (e.g., https://grc.yourcompany.com)
CSRF_TRUSTED_ORIGINS=https://<YOUR_DOMAIN>

# Initial Superuser Bootstrapping (Created automatically on first startup if configured)
CISO_ASSISTANT_SUPERUSER_EMAIL=admin@<YOUR_DOMAIN>
CISO_ASSISTANT_SUPERUSER_PASSWORD=<YOUR_ADMIN_PASSWORD>
FORCE_CREATE_ADMIN=False

# Authentication Token Settings
AUTH_TOKEN_TTL=7200
AUTH_TOKEN_AUTO_REFRESH=True
AUTH_TOKEN_AUTO_REFRESH_MAX_TTL=36000

# =========================================================
# 3. DATABASE CONFIGURATION (MSSQL / POSTGRESQL / SQLITE)
# =========================================================
# Database Engine: 'mssql', 'django.db.backends.postgresql', or 'django.db.backends.sqlite3'
DB_ENGINE=mssql
DB_NAME=master
DB_USER=sa
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_HOST=db
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ODBC_EXTRA_PARAMS=TrustServerCertificate=yes

# MSSQL Container EULA Acceptance
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=<YOUR_DB_PASSWORD>
MSSQL_PID=Developer

# =========================================================
# 4. FRONTEND CONFIGURATION (SVELTEKIT)
# =========================================================
PUBLIC_BACKEND_API_URL=http://backend:8000/api
PUBLIC_BACKEND_API_EXPOSED_URL=https://<YOUR_DOMAIN>/api
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# =========================================================
# 5. EMAIL PROVIDER CONFIGURATION
# =========================================================
# Active provider: 'mailhog' (local dev/testing) or 'microsoft365' (production)
EMAIL_PROVIDER=mailhog

# Option A: MailHog Local Development (Default)
# DEFAULT_FROM_EMAIL=noreply@ciso.assistant
# EMAIL_HOST=mailhog
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=False

# Option B: Microsoft 365 / Exchange Online (Production Modern Auth / XOAUTH2)
# Required when EMAIL_PROVIDER=microsoft365
MICROSOFT_TENANT_ID=<YOUR_MICROSOFT_TENANT_ID_GUID>
MICROSOFT_CLIENT_ID=<YOUR_MICROSOFT_CLIENT_ID_GUID>
MICROSOFT_CLIENT_SECRET=<YOUR_MICROSOFT_CLIENT_SECRET_VALUE>
DEFAULT_FROM_EMAIL=ciso-alerts@<YOUR_DOMAIN>
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_FORCE_TLS_1_2=True
EMAIL_TIMEOUT=10

# =========================================================
# 6. HUEY BACKGROUND WORKER CONFIGURATION
# =========================================================
# File path for Huey Sqlite task queue database
HUEY_FILE_PATH=/code/db/huey.db

# =========================================================
# 7. OPTIONAL SERVICES (QDRANT VECTOR DB & AUDIT LOGS)
# =========================================================
QDRANT_URL=http://qdrant:6333
AUDITLOG_RETENTION_DAYS=90
AUDITLOG_MAX_RECORDS=50000
ALLOW_PRIVATE_NETWORK_REQUESTS=False
