# External SQL Server template (no database container on this server).
# deploy.sh uses it when run as:  AMLI_DB_MODE=external AMLI_DB_PASSWORD='<password>' bash deploy.sh
CISO_ASSISTANT_URL=https://__HOST__:8443
ALLOWED_HOSTS=__HOST__,localhost,backend
CSRF_TRUSTED_ORIGINS=https://__HOST__:8443
PUBLIC_BACKEND_API_URL=http://backend:8000/api
PUBLIC_BACKEND_API_EXPOSED_URL=https://__HOST__:8443/api

DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_DEBUG=False

CISO_ASSISTANT_SUPERUSER_EMAIL=admin@yourcompany.com
CISO_ASSISTANT_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

DB_ENGINE=mssql
DB_HOST=172.23.51.190
DB_PORT=1433
DB_NAME=ISGRC
DB_USER=ISGRC
DB_PASSWORD='__DB_PASSWORD__'
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ODBC_EXTRA_PARAMS=TrustServerCertificate=yes

EMAIL_PROVIDER=mailhog
